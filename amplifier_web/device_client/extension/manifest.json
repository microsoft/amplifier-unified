{
  "manifest_version": 3,
  "name": "Amplifier Connect Preview",
  "version": "0.2.1",
  "description": "Connect a selected browser document or explicitly enable tasks across pages in one chosen tab.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "activeTab",
    "debugger"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Amplifier Connect",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      }
    }
  },
  "externally_connectable": {
    "matches": [
      "https://*/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
