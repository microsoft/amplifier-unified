{
  "name": "@amplifier/client-web",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:history-browser": "node tests/native-history-browser.mjs",
    "prebuild": "node scripts/sync-branding.mjs",
    "predev": "node scripts/sync-branding.mjs",
    "test:conversation-navigation-browser": "node tests/conversation-navigation-browser.mjs",
    "test:pending-view-browser": "node tests/pending-view-browser.mjs",
    "test:review-during-send-browser": "node tests/review-during-send-browser.mjs",
    "test:typing-audit-browser": "node tests/typing-audit-browser.mjs",
    "test:activity-feedback-browser": "node tests/activity-feedback-browser.mjs",
    "test:message-outbox-browser": "node tests/message-outbox-browser.mjs",
    "test:legacy-outbox-notice-browser": "node tests/legacy-outbox-notice-browser.mjs",
    "test:new-chat-recovery-browser": "node tests/new-chat-recovery-browser.mjs",
    "test:sidebar-controls-browser": "node tests/sidebar-controls-browser.mjs",
    "prepare:inputs": "node scripts/prepare-inputs.mjs",
    "package:artifact": "node scripts/package-client.mjs",
    "test:portable": "npm test",
    "test:artifact": "node tests/client-artifact-browser.mjs",
    "test:delivery-recovery-browser": "node tests/delivery-reconciliation-browser.mjs && node tests/delivery-new-chat-browser.mjs",
    "test:navigation": "node --test tests/adaptive-work.test.mjs tests/chat-navigation.test.mjs tests/navigation-demand.test.mjs tests/navigation-snapshot.test.mjs tests/shell-navigation-demand.test.mjs tests/shell-panels.test.mjs tests/shell-resources.test.mjs tests/work-shell.test.mjs tests/chat-row.test.mjs",
    "test:updates": "node --test tests/update-overview.test.mjs tests/updates.test.mjs",
    "test:artifact-assets": "node --test tests/artifact/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@viz-js/viz": "^3.30.0",
    "babylonjs": "9.26.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.17.2",
    "pdfjs-dist": "6.4.299",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.8",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "react-test-renderer": "^19.2.4",
    "vite": "^6.4.5"
  },
  "overrides": {
    "katex": "0.18.2"
  }
